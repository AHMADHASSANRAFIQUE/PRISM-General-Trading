# Prism General Trading - Environment Configuration Example
# Copy this file to .env.local for local development or set in your deployment dashboard (e.g. Vercel)

# Base website URL (used for canonical links, sitemaps, and OpenGraph)
NEXT_PUBLIC_SITE_URL=https://prisminl.co

# Recipient Email for Contact Enquiries
CONTACT_RECIPIENT_EMAIL=info@prisminl.co

# Optional SMTP Configuration for direct email dispatch (leave blank to persist enquiries locally in /data/enquiries.jsonl)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@prisminl.co

# Rate Limiting Configuration (requests per 10-minute window per IP)
CONTACT_RATE_LIMIT=5
